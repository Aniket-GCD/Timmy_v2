# Copy to .env.local and fill from Supabase → Settings → API.
# Restart `npm run dev` after changing any NEXT_PUBLIC_* var.
# On Vercel: set the same keys (Production + Preview), then redeploy.

NEXT_PUBLIC_DASHBOARD_DATA_SOURCE=supabase

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Auth cookies only — anon / sb_publishable_… (never use this for server writes)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# REQUIRED for create/edit: service_role JWT or sb_secret_… (bypasses RLS after session check).
# Publishable-only keys often make PATCH return [] with no row update — Save looks like it worked then reverts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key

SUPABASE_ENTRIES_TABLE=time_entries_timmy_v2
# SUPABASE_CLIENTS_TABLE=clients
# SUPABASE_JOB_CODES_TABLE=job_codes
# SUPABASE_EMPLOYEES_TABLE=employees
# SUPABASE_CURRENTLY_WORKING_TABLE=currently_working
